# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL takes precedence over the POSTGRES_* values when set:
# DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/tasks_db

# Redis — read by db/database.py and tasks.py
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL takes precedence for the Redis client when set:
# REDIS_URL=redis://localhost:6379/0
# Declared by the Docker compose files for the Redis image.
# tasks.py reads it but the broker URL does not include it (currently unused):
REDIS_PASSWORD=change-me

# Auth (required — startup fails without these)
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_DURATION=15
REFRESH_TOKEN_DURATION=7
